<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barca_workorder_activity_selection_wizard_form" model="ir.ui.view">
        <field name="name">barca.workorder.activity.selection.wizard.form</field>
        <field name="model">barca.maintenance.workorder.activity.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar varias actividades">
                <group>
                    <field name="maintenance_request_id" readonly="1"/>
                    <field name="vehicle_category_id" readonly="1"/>
                </group>

                <separator string="Marque las actividades que desea incorporar a la OT"/>
                <field name="selection_line_ids" nolabel="1">
                    <list create="0" delete="0" editable="bottom">
                        <field name="selected"/>
                        <field name="technical_location_id" readonly="1"/>
                        <field name="activity_id" readonly="1" force_save="1"/>
                        <field name="intervention_type_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="estimated_duration" readonly="1" optional="show"/>
                        <field name="material_count" readonly="1" optional="show"/>
                        <field name="material_summary" readonly="1" optional="hide"/>
                    </list>
                </field>

                <footer>
                    <button name="action_add_activities"
                            string="Agregar seleccionadas"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
